// Copy this file to secrets.h (same folder) and fill in your network.
// secrets.h is in .gitignore, so your credentials never reach the repo.
#pragma once
#define WIFI_SSID   "your-wifi-name"
#define WIFI_PASS   "your-wifi-password"

// Password for firmware updates over Wi-Fi (ota.h, tools/ota_upload.sh).
// Leave it out and OTA stays off.
#define OTA_PASSWORD "choose-a-long-password"
