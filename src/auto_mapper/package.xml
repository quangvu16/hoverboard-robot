<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auto_mapper</name>
  <version>0.0.0</version>
  <description>Autonomous mapper using slam toolbox</description>
  <maintainer email="omar.gamil.salem@gmail.com">omar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_map_server</depend>
  <depend>slam_toolbox</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_util</depend>
  <depend>std_msgs</depend>
  <depend>map_msgs</depend>
  <depend>angles</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- bringup_launch.py runs the nav2 nodes in a component container. -->
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <!-- Deliberately NOT dependencies:
       rviz2 - auto_mapper.launch.py can start it, but only with rviz:=true,
         which is off by default. This package drives a robot to build a map and
         runs onboard, where there is no display; making rviz2 a dependency
         installs a GUI stack (and its Qt/OpenGL chain) on the robot. Install
         rviz2 on the dev PC that uses rviz:=true.
       joint_state_publisher_gui - never referenced; pure GUI.
       controller_manager, joint_state_broadcaster, forward_command_controller,
       diff_drive_controller, joint_trajectory_controller,
       ros2_controllers_test_nodes, ros2_control_test_assets - the ros2_control
         stack. Never referenced; this package sends nav2 goals, it does not
         host controller plugins.
       joint_state_publisher, xacro, robot_localization - never referenced;
         the robot description package owns those.
       behaviortree_cpp_v3, rclcpp_lifecycle - never included, and not in the
         CMakeLists deps list, so they were never found or linked.
       ament_cmake_gmock - there are no tests to build. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

