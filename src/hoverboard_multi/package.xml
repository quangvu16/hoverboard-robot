<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hoverboard_multi</name>
  <version>0.0.0</version>
  <description>Several hoverboard robots: namespaced bringup and Nav2, formation driving, multi-robot control</description>
  <maintainer email="quangvu82@gmail.com">vu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>esp_tcp_server</exec_depend>
  <exec_depend>hoverboard_base_node</exec_depend>
  <exec_depend>hoverboard_description</exec_depend>
  <exec_depend>hoverboard_ctrl</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
