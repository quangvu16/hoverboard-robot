<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hoverboard_nav</name>
  <version>0.0.0</version>
  <description>Mapping, navigation and map saving launches for the hoverboard robot</description>
  <maintainer email="quangvu82@gmail.com">vu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>robot_navigation</exec_depend>
  <exec_depend>robot_cartographer</exec_depend>
  <exec_depend>slam_gmapping</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_pose_publisher_ros2</exec_depend>
  <exec_depend>hoverboard_app_save_map</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
