<?xml version="1.0" encoding="utf-8"?>
<!-- Map on top (pinch/drag), status and controls underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRobot"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Robot address"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView android:id="@+id/pConn" style="@style/Pill" android:text="disconnected" />
            <TextView android:id="@+id/pStack" style="@style/Pill" android:text="stack ?" />
            <TextView android:id="@+id/pNav" style="@style/Pill" android:text="Nav2 ?" />
            <TextView android:id="@+id/pMap" style="@style/Pill" android:text="no map" />
            <TextView android:id="@+id/pBatt" style="@style/Pill" android:text="battery ?" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.25">

        <com.hoverboard.robotnav.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sunk"
            android:contentDescription="Map. Tap to place a goal, drag to set its heading, pinch to zoom." />

        <TextView
            android:id="@+id/overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Waiting for /map…"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/mGoal" style="@style/ToolButton" android:text="Goal" />
                <Button android:id="@+id/mPose" style="@style/ToolButton" android:text="Set pose" />
                <Button android:id="@+id/mPan" style="@style/ToolButton" android:text="Pan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <Button android:id="@+id/zFit" style="@style/ToolButton" android:text="Fit" />
                <Button android:id="@+id/zRobot" style="@style/ToolButton" android:text="Robot" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/surface"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Drive by hand: /cmd_vel_manual while the stick is held. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:text="DRIVE" />

                <TextView android:id="@+id/pSonar" style="@style/Pill" android:layout_marginEnd="0dp" android:text="sonar ?" />
            </LinearLayout>

            <com.hoverboard.robotnav.JoystickView
                android:id="@+id/stick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:contentDescription="Drive stick. Drag to drive, release to stop." />

            <TextView
                android:id="@+id/dCmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:text="stopped"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <!-- /range/{front,left,right} from the bridge -->
            <TextView
                android:id="@+id/dSonar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:text="sonar  front —  left —  right —"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="Max speed"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/dV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="9" />

                <TextView
                    android:id="@+id/dVo"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="Max turn"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/dW"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="18" />

                <TextView
                    android:id="@+id/dWo"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded"
                android:backgroundTint="@color/bad"
                android:stateListAnimator="@null"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- twist_mux lock (/cmd_vel_lock): holds the robot still, sticks included -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dLock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="lock: unknown"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <Button android:id="@+id/btnHold" style="@style/ToolButton" android:text="Hold still" />
                <Button android:id="@+id/btnRelease" style="@style/ToolButton" android:layout_marginEnd="0dp" android:text="Release" />
            </LinearLayout>

            <!-- robot_docking dock_manager: /dock/command, /dock/status -->
            <TextView style="@style/Section" android:text="DOCK" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/kDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pill"
                    android:backgroundTint="@color/muted" />

                <TextView
                    android:id="@+id/kState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="dock ?"
                    android:textColor="@color/fg"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/kMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Needs robot_docking (web_nav.launch.py docking:=true)."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnDock" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:text="Dock" />
                <Button android:id="@+id/btnUndock" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:text="Undock" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnDockSave" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:text="Set dock here" />
                <Button android:id="@+id/btnDockCancel" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:text="Cancel" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/kAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/accent"
                android:text="Dock by itself when the battery is low"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView style="@style/Section" android:text="NAVIGATION" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pill"
                    android:backgroundTint="@color/muted" />

                <TextView
                    android:id="@+id/sState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Idle"
                    android:textColor="@color/fg"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/rounded"
                    android:backgroundTint="@color/bad"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Cancel goal"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="20dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TableLayout
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:stretchColumns="1" />

            <TextView style="@style/Section" android:text="SAVED SPOTS" />

            <LinearLayout
                android:id="@+id/spots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/spotName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Name, e.g. kitchen"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/spotSave"
                    style="@style/ToolButton"
                    android:layout_marginStart="8dp"
                    android:text="Save here" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
